# =============================================================================
# FORGE AI Engine — Environment Variables (ai/.env)
# =============================================================================
# Copy this file to ai/.env and fill in at least ONE LLM provider key.
# The Playground, Agents, and Workflows are all non-functional without one.
# =============================================================================

# --- Required: Internal auth secret (must match server/.env) -----------------
# Change this to any random string before deploying. Keep both files in sync.
INTERNAL_SERVICE_SECRET=forge_dev_secret_key_12345

# --- LLM Provider Keys (need at least ONE) ------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Optional: GitHub Connector -----------------------------------------------
# Only needed if you want the Agent pipeline to create GitHub repos.
# Get from: https://github.com/settings/tokens (needs repo scope)
GITHUB_TOKEN=

# --- Optional: Qdrant Cloud Vector DB -----------------------------------------
# Leave BOTH blank to use the local file-based Qdrant (default, zero setup).
# Fill in BOTH only if you want to use Qdrant Cloud for persistent vectors.
# Get from: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# --- Server binding (change only if port 8000 is taken) -----------------------
AI_HOST=127.0.0.1
AI_PORT=8000
