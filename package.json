{
  "name": "forge-ai-workspace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FORGE - AI Software Development Workspace",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
