# ==============================================
# FORGE AI System Environment Configuration
# ==============================================

# Node / Express Server
PORT=5000
NODE_ENV=development

# Internal Seam Authentication (Shared between Express and FastAPI)
INTERNAL_SERVICE_SECRET=forge_internal_secret_change_in_production
AI_SERVICE_URL=http://localhost:8000

# AI Provider Keys (Used by Python AI service)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# GitHub Integration (Phase 4/5 repo creation)
GITHUB_TOKEN=

# Qdrant Vector Store (Leave empty for embedded/local disk mode)
QDRANT_URL=
QDRANT_API_KEY=
