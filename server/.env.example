# =============================================================================
# FORGE Node/Express Server — Environment Variables (server/.env)
# =============================================================================
# This file already exists with these defaults for local dev.
# Only change INTERNAL_SERVICE_SECRET (keep it in sync with ai/.env).
# =============================================================================

PORT=5000
NODE_ENV=development

# Must match INTERNAL_SERVICE_SECRET in ai/.env
INTERNAL_SERVICE_SECRET=forge_dev_secret_key_12345

# URL where the Python AI service is running
AI_SERVICE_URL=http://localhost:8000
